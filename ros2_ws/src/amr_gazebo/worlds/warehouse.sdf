<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="warehouse">

    <!-- Physics -->
    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <!-- Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== WAREHOUSE WALLS ==================== -->
    <!-- South wall (y=0) -->
    <model name="wall_south">
      <static>true</static>
      <pose>10 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>20 0.2 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>20 0.2 1.0</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- North wall (y=15) -->
    <model name="wall_north">
      <static>true</static>
      <pose>10 15 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>20 0.2 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>20 0.2 1.0</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- West wall (x=0) -->
    <model name="wall_west">
      <static>true</static>
      <pose>0 7.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 15 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 15 1.0</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- East wall (x=20) -->
    <model name="wall_east">
      <static>true</static>
      <pose>20 7.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 15 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 15 1.0</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== SHELF BLOCKS ==================== -->
    <!-- Shelf S1-top (left shelf, upper portion) -->
    <model name="shelf_s1_top">
      <static>true</static>
      <pose>5.5 10.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3.0 3.0 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.0 3.0 1.0</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Shelf S1-bottom (left shelf, lower portion) -->
    <model name="shelf_s1_bottom">
      <static>true</static>
      <pose>5.5 5.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3.0 3.0 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.0 3.0 1.0</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Shelf S2-top (right shelf, upper portion) -->
    <model name="shelf_s2_top">
      <static>true</static>
      <pose>14.5 10.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3.0 3.0 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.0 3.0 1.0</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Shelf S2-bottom (right shelf, lower portion) -->
    <model name="shelf_s2_bottom">
      <static>true</static>
      <pose>14.5 5.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3.0 3.0 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.0 3.0 1.0</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- The chokepoint is the gap between S1 and S2 blocks around x=7..13, y=3.5..12
         The actual narrow gap is at x≈7..13 between the shelf pairs.
         We narrow it further with small wall stubs to create a 1.2m gap at y=7.5 -->

    <!-- Chokepoint narrowing wall - left -->
    <model name="choke_wall_left">
      <static>true</static>
      <pose>8.8 7.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 2.0 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 2.0 1.0</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Chokepoint narrowing wall - right -->
    <model name="choke_wall_right">
      <static>true</static>
      <pose>11.8 7.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 2.0 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 2.0 1.0</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- The navigable gap is x=9.1 to x=11.5, width ≈ 2.4m at y=7.5 
         This is wide enough for one robot (0.5m diameter) but not two side by side -->

  </world>
</sdf>
