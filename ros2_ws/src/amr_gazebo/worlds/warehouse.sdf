<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="warehouse">

    <!-- ══════════════════════════════════════════════════════ -->
    <!-- Physics                                               -->
    <!-- ══════════════════════════════════════════════════════ -->
    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- ══════════════════════════════════════════════════════ -->
    <!-- Plugins                                               -->
    <!-- ══════════════════════════════════════════════════════ -->
    <plugin filename="gz-sim-physics-system"        name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"  name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"        name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-contact-system"        name="gz::sim::systems::Contact"/>

    <!-- ══════════════════════════════════════════════════════ -->
    <!-- Lighting — Industrial overhead                        -->
    <!-- ══════════════════════════════════════════════════════ -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 30 0 0.4 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.3 0.1 -0.95</direction>
    </light>
    <!-- Secondary fill light -->
    <light type="directional" name="fill_light">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.4 0.4 0.5 1</diffuse>
      <specular>0.0 0.0 0.0 1</specular>
      <direction>0.4 -0.2 -0.9</direction>
    </light>

    <!-- ══════════════════════════════════════════════════════ -->
    <!-- Camera — Isometric top-down like reference image      -->
    <!-- ══════════════════════════════════════════════════════ -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>30.0 -20.0 55.0 0 0.95 1.5708</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <!-- ══════════════════════════════════════════════════════ -->
    <!-- GROUND PLANE  (60 m × 40 m)                          -->
    <!-- ══════════════════════════════════════════════════════ -->
    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material>
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.35 0.35 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ══════════════════════════════════════════════════════ -->
    <!-- WAREHOUSE FLOOR  60 m × 40 m concrete                -->
    <!-- Origin: (30, 20, 0) → corners (0,0) to (60,40)       -->
    <!-- ══════════════════════════════════════════════════════ -->
    <model name="warehouse_floor">
      <static>true</static>
      <pose>30 20 0.001 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>60.0 40.0 0.002</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>60.0 40.0 0.002</size></box></geometry>
          <material>
            <ambient>0.68 0.68 0.70 1</ambient>
            <diffuse>0.68 0.68 0.70 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ══════════════════════════════════════════════════════ -->
    <!-- WAREHOUSE WALLS  (4m tall)                           -->
    <!-- ══════════════════════════════════════════════════════ -->
    <!-- South wall y=0 -->
    <model name="wall_south">
      <static>true</static><pose>30 0 2.0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>60.2 0.3 4.0</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>60.2 0.3 4.0</size></box></geometry>
          <material><ambient>0.78 0.80 0.82 1</ambient><diffuse>0.78 0.80 0.82 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- North wall y=40 -->
    <model name="wall_north">
      <static>true</static><pose>30 40 2.0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>60.2 0.3 4.0</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>60.2 0.3 4.0</size></box></geometry>
          <material><ambient>0.78 0.80 0.82 1</ambient><diffuse>0.78 0.80 0.82 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- West wall x=0 -->
    <model name="wall_west">
      <static>true</static><pose>0 20 2.0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.3 40.2 4.0</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.3 40.2 4.0</size></box></geometry>
          <material><ambient>0.78 0.80 0.82 1</ambient><diffuse>0.78 0.80 0.82 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- East wall x=60 -->
    <model name="wall_east">
      <static>true</static><pose>60 20 2.0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.3 40.2 4.0</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.3 40.2 4.0</size></box></geometry>
          <material><ambient>0.78 0.80 0.82 1</ambient><diffuse>0.78 0.80 0.82 1</diffuse></material>
        </visual>
      </link>
    </model>

