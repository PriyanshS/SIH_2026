Panels:
  - Class: rviz_common/Displays
    Help Height: 120
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Warehouse Map1
        - /Robot 1 Pose (Red)1
        - /Robot 2 Pose (Green)1
        - /Robot 3 Pose (Blue)1
      Splitter Ratio: 0.6000000238418579
    Tree Height: 287
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
